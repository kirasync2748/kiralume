  "tokenColors": [
    {
      "name": "Readable fallback",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#202d42"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#202d42"
      }
    },
    {
      "name": "Language built-ins",
      "scope": [
        "support",
        "variable.language"
      ],
      "settings": {
        "foreground": "#006c78"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#785900"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.annotation",
        "entity.name.function.decorator",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#785900"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#7045a4"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#785900"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.type.property-name.css",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#006c78"
      }
    },
    {
      "name": "Data keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml",
        "entity.other.attribute-name.toml"
      ],
      "settings": {
        "foreground": "#355ea6"
      }
