  "tokenColors": [
    {
      "name": "Readable fallback",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#302a34"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#302a34"
      }
    },
    {
      "name": "Language built-ins",
      "scope": [
        "support",
        "variable.language"
      ],
      "settings": {
        "foreground": "#006b73"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#765700"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.annotation",
        "entity.name.function.decorator",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#765700"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#714797"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#765700"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.type.property-name.css",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#006b73"
      }
    },
    {
      "name": "Data keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml",
        "entity.other.attribute-name.toml"
      ],
      "settings": {
        "foreground": "#725091"
      }
    },
    {
      "name": "Template expressions",
      "scope": [
        "punctuation.section.embedded",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#714797"
      }
    },
    {
      "name": "Diff additions",
