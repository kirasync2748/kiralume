  "tokenColors": [
    {
      "name": "Readable fallback",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#e2e7f5"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#e2e7f5"
      }
    },
    {
      "name": "Language built-ins",
      "scope": [
        "support",
        "variable.language"
      ],
      "settings": {
        "foreground": "#86d9ed"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#ead28b"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.annotation",
        "entity.name.function.decorator",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#ead28b"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#d0b7ff"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#ead28b"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.type.property-name.css",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#86d9ed"
      }
    },
    {
      "name": "Data keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml",
